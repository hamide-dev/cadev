NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/hello_world
DATABASE_SSL=false
JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_characters
CORS_ORIGINS=http://localhost:3001

# Optional Cloudinary configuration (all three values are required together).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP relay.
# Local development: `docker compose up -d` starts Mailpit (inbox on http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@hello-world.local
SMTP_FROM_NAME=Hello World

# Optional Google OAuth configuration (all three values are required together).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Optional GitHub OAuth configuration (all three values are required together).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
