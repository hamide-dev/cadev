NODE_ENV=development
PORT=3000

# PostgreSQL local or Systalink Datacloud connection
DATABASE_URL=postgresql://hello_world:change_me@localhost:5432/hello_world
DATABASE_SSL=false

# Replace with a random secret of at least 32 characters.
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_of_at_least_32_chars

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3001

# Optional until Cloudinary is configured; keep all three empty or set all three.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo SMTP for verification codes sent after local account registration.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Hello World

# OAuth providers are optional; set all three values for each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
