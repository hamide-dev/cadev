NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/hello_world
DATABASE_SSL=false
JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_characters
FRONTEND_API_KEY=replace_with_the_same_random_key_used_as_VITE_API_KEY
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY_HOPS=0

# Docker Compose settings (run from the repository root with --env-file backend/.env).
POSTGRES_DB=hello_world
POSTGRES_USER=hello_world
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password
FRONTEND_PORT=8080
APP_ORIGIN=http://localhost:8080

# Optional Cloudinary configuration (all three values are required together).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo transactional email (Settings > SMTP & API; use an SMTP key, not an API key).
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Hello World

# Optional Google OAuth configuration (all three values are required together).
# Google redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Optional GitHub OAuth configuration (all three values are required together).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
