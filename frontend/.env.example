# URL du back NestJS, sans /api/v1
VITE_API_URL=http://localhost:3000
# URL Socket.IO (facultatif, reprend VITE_API_URL par défaut)
# VITE_SOCKET_URL=http://localhost:3000
# Must match FRONTEND_API_KEY in backend/.env. This key is public in browser code.
VITE_API_KEY=replace_with_the_same_random_key_used_in_backend
